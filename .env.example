# AutoApply — required environment variables
# Copy this file to .env and fill in your values.

# OpenRouter API key (required for LLM calls)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Anthropic API key (optional — only needed if NOT using OpenRouter)
ANTHROPIC_API_KEY=

# Purdue GenAI Studio (optional alternative backend)
GENAI_STUDIO_API_KEY=

# Gmail IMAP for auto-reading OTP codes and verification emails
# 1. Go to myaccount.google.com → Security → 2-Step Verification → App passwords
# 2. Generate an app password for "Mail"
# 3. Paste the 16-character password below (no spaces)
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=
